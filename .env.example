# DSM base URL, including scheme and optional port. Do not add /webapi.
DSM_URL=https://nas.example.com
DSM_USERNAME=
DSM_PASSWORD=

# Leave empty to use the Download Station default destination.
DSM_DOWNLOAD_DIR=

# Keep true for publicly trusted or correctly installed certificates.
# Set false only when the DSM endpoint uses a self-signed certificate.
DSM_VERIFY_SSL=true
